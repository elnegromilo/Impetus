<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior de ajustes del recordatorio. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/impetus_on_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/impetus_muted" />

        <!-- Aviso si las notificaciones están apagadas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notifications_off"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell_off"
                    app:tint="@color/impetus_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:text="@string/settings_notifications_off"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/impetus_on_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sheet_enable"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hora -->
        <LinearLayout
            android:id="@+id/row_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_schedule"
                app:tint="@color/impetus_muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_time"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/impetus_on_background" />

                <TextView
                    android:id="@+id/tv_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/impetus_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contenido de la notificación -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/settings_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/impetus_on_background" />

        <RadioGroup
            android:id="@+id/rg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_content_quote" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_verse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_content_verse" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_content_both" />
        </RadioGroup>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:minHeight="48dp"
            android:text="@string/settings_test"
            app:icon="@drawable/ic_bell" />

        <TextView
            android:id="@+id/tv_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/impetus_muted" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
